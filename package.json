{
  "name": "simulatusengine",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "rm -rf build/run/* && echo \"Building...\"; tsc --noEmit && npx vite build && echo \"Copying scripts...\"; cp src/script/ -r build/run/script && echo \"Removing source files...\"; rm build/run/script/game/**/src/ -rf; rm build/run/script/game/*.ts -rf; echo \"Done!\"",
    "build_packs": "python tools/build_packs.py",
    "build_pack": "python tools/build_pack.py -i",
    "create_pack": "python tools/create_pack.py -i",
    "install_pack": "python tools/install_pack.py -i",
    "install_packs": "python tools/install_packs.py",
    "list_templates": "python tools/create_pack.py -lt",
    "run": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oDaniel728/SimulatusEngine.git"
  },
  "keywords": [],
