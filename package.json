  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "javascript-obfuscator": "^5.4.2",
    "sass": "^1.99.0",
    "ts-morph": "^28.0.0",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "dependencies": {
